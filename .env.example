# Copy this file to .env and fill in your key(s).

# Main LLM provider: gemini or groq
LLM_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# How much Gemini reasons before answering: low (fastest, least quota), medium, high
GEMINI_THINKING_LEVEL=low

# Groq: free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Backup model, used automatically if the main model fails (e.g. "high demand" errors).
# Skipped if its provider has no key. Set FALLBACK_PROVIDER= (empty) to disable.
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=openai/gpt-oss-120b

# Local SQLite database (relative paths are resolved from the project folder)
DB_PATH=data/airports.db
