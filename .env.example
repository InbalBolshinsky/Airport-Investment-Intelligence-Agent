# Copy this file to .env and fill in your key(s).

# Main LLM provider: gemini or groq
LLM_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# How much Gemini reasons before answering: low (fastest, least quota), medium, high
GEMINI_THINKING_LEVEL=low

# Groq: free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Backup models, tried in order if the main model fails (e.g. "high demand" or quota errors).
# Format provider:model, comma-separated. Entries whose provider has no key are skipped.
# Set FALLBACKS= (empty) to disable.
FALLBACKS=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b

# Local SQLite database (relative paths are resolved from the project folder)
DB_PATH=data/airports.db
