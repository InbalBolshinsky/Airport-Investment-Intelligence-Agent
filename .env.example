# Copy this file to .env and fill in the key for the provider you use.

# Which LLM provider the agent uses: gemini or groq
LLM_PROVIDER=gemini

# Gemini: free key from https://aistudio.google.com
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq: free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local SQLite database (relative paths are resolved from the project folder)
DB_PATH=data/airports.db
